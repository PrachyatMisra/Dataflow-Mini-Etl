# ---------------------------------------------------------------------------
# DataFlow Mini ETL - environment template
# Copy to .env and adjust. Every value is optional; sane defaults apply.
# ---------------------------------------------------------------------------

# --- Sources ---------------------------------------------------------------
#COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
#FEAR_GREED_BASE_URL=https://api.alternative.me
#VS_CURRENCY=usd
#MARKET_LIMIT=25
#TREND_COIN_COUNT=5
#TREND_DAYS=7
#FEAR_GREED_DAYS=30
#STABLECOIN_SYMBOLS=usdt,usdc,dai,usds,usde,usd1,tusd

# --- HTTP behaviour ----------------------------------------------------------
#HTTP_TIMEOUT_SECONDS=20
#HTTP_MAX_RETRIES=4
#HTTP_BACKOFF_SECONDS=1.5

# --- Warehousing -------------------------------------------------------------
# PostgreSQL (used automatically when set, e.g. inside Docker Compose)
#DATABASE_URL=postgresql://etl:etl@localhost:5432/dataflow
# SQLite fallback path (used when DATABASE_URL is empty)
#SQLITE_PATH=data/dataflow.db

# --- Outputs -------------------------------------------------------------
#ARTIFACT_DIR=artifacts
#EXPORT_DIR=docs/data

# --- Data-quality gate -----------------------------------------------------
#MIN_ROWS=10
#FRESHNESS_MAX_HOURS=24
#NULL_TOLERANCE_PCT=5

# --- Misc ------------------------------------------------------------------
#LOG_LEVEL=INFO
#SOURCE_MODE=api
#FIXTURE_DIR=tests/fixtures
